
# ============================================================
# ORIGEN
# Enterprise Portfolio Project
# .gitignore
# ============================================================

# ---------- Operating System ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- IDEs ----------
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ---------- Logs ----------
logs/
*.log

# ---------- Java / Maven ----------
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class

# ---------- Spring Boot ----------
backend/.springBeans
backend/.sts4-cache

# ---------- Node / Angular ----------
frontend/node_modules/
frontend/.angular/
frontend/dist/
frontend/coverage/
frontend/.cache/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# ---------- Environment ----------
.env
.env.*
!.env.example

# ---------- SQL ----------
*.bak
*.mdf
*.ldf

# ---------- Docker ----------
**/.docker/

# ---------- Test Results ----------
coverage/
test-output/

# ---------- Temporary ----------
tmp/
temp/
*.tmp
*.swp
*.swo

# ---------- Archives ----------
*.zip
*.7z
*.rar

# ---------- Build Artifacts ----------
build/
out/

# ---------- Generated Documentation ----------
site/

# ---------- OS Generated ----------
$RECYCLE.BIN/

# ---------- VS Generated ----------
.vscode/

# ---------- Spring Profiles ----------
**/application-local.yml
