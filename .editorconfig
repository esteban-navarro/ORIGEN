# ============================================================
# ORIGEN
# Enterprise Portfolio Project
# .editorconfig
# https://editorconfig.org
# ============================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.{xml,html}]
indent_size = 2

[*.scss]
indent_size = 2

[*.css]
indent_size = 2

[*.ts]
indent_size = 2

[*.js]
indent_size = 2

[*.java]
indent_size = 4

[*.sql]
indent_size = 4

[*.properties]
indent_size = 2

[*.bat]
end_of_line = crlf

[Makefile]
indent_style = tab
